{
  "name": "@vgtd/sprite",
  "version": "0.1.0",
  "description": "Frame-by-frame AI sprite-sheet pipeline for Player bodies (D41): template, slicer, aligner, palette lock, atlas, exporter, QA.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "sprite:layers": "node ../rig/scripts/run-ts.mjs scripts/layers.ts",
    "sprite:layer-template": "node ../rig/scripts/run-ts.mjs scripts/layer-template.ts",
    "sprite:template": "node ../rig/scripts/run-ts.mjs scripts/template.ts",
    "sprite:variant-check": "node ../rig/scripts/run-ts.mjs scripts/variant-check.ts",
    "sprite:template-group": "node ../rig/scripts/run-ts.mjs scripts/template-group.ts",
    "sprite:build": "node ../rig/scripts/run-ts.mjs scripts/build.ts",
    "sprite:repair": "node ../rig/scripts/run-ts.mjs scripts/repair.ts",
    "sprite:backlog": "node ../rig/scripts/run-ts.mjs scripts/backlog.ts",
    "sprite:batch": "node ../rig/scripts/run-ts.mjs scripts/batch.ts",
    "sprite:review": "node ../rig/scripts/run-ts.mjs scripts/review.ts"
  },
  "dependencies": {
    "@vgtd/character": "*",
    "@vgtd/rig": "*",
    "@vgtd/shared": "*"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
