{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vgtd.local/data/kiem-tu.rig.schema.json",
  "description": "Data-only draft snapshot of the coordinated @vgtd/rig RigDocument schema; canonical schema is owned by worker 15.",
  "type": "object",
  "required": ["id", "rigs"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "kiem-tu"
    },
    "rigs": {
      "type": "object",
      "required": ["S", "SE", "E", "NE", "N"],
      "additionalProperties": false,
      "properties": {
        "S": {
          "allOf": [
            {
              "$ref": "#/$defs/document"
            },
            {
              "properties": {
                "direction": {
                  "const": "S"
                }
              }
            }
          ]
        },
        "SE": {
          "allOf": [
            {
              "$ref": "#/$defs/document"
            },
            {
              "properties": {
                "direction": {
                  "const": "SE"
                }
              }
            }
          ]
        },
        "E": {
          "allOf": [
            {
              "$ref": "#/$defs/document"
            },
            {
              "properties": {
                "direction": {
                  "const": "E"
                }
              }
            }
          ]
        },
        "NE": {
          "allOf": [
            {
              "$ref": "#/$defs/document"
            },
            {
              "properties": {
                "direction": {
                  "const": "NE"
                }
              }
            }
          ]
        },
        "N": {
          "allOf": [
            {
              "$ref": "#/$defs/document"
            },
            {
              "properties": {
                "direction": {
                  "const": "N"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["format", "version", "id", "kind", "direction", "canvas", "bones", "roles", "slots", "skins"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "vgtd-rig"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["player", "boss", "mob", "npc", "pet"]
        },
        "direction": {
          "enum": ["S", "SE", "E", "NE", "N", "NW", "W", "SW"]
        },
        "canvas": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "bones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "parent", "length", "x", "y", "rotation"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": ["string", "null"]
              },
              "length": {
                "type": "number",
                "minimum": 0
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "type": "number"
              },
              "scaleX": {
                "type": "number"
              },
              "scaleY": {
                "type": "number"
              },
              "inheritRotation": {
                "type": "boolean"
              }
            }
          }
        },
        "ik": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "bones", "target", "bendPositive"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "bones": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "bendPositive": {
                "type": "boolean"
              },
              "mix": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "bones", "stiffness", "damping"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["hair", "ribbon", "sash", "sleeve", "cape", "tail", "other"]
              },
              "bones": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stiffness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "damping": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "gravity": {
                "type": "number"
              },
              "inertia": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "roles": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "root",
              "hips",
              "spine_mid",
              "spine_upper",
              "head",
              "upper_arm_L",
              "lower_arm_L",
              "hand_L",
              "upper_arm_R",
              "lower_arm_R",
              "hand_R",
              "thigh_L",
              "shin_L",
              "foot_L",
              "thigh_R",
              "shin_R",
              "foot_R",
              "ik_foot_L",
              "ik_foot_R",
              "ik_hand_L",
              "ik_hand_R"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sockets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "bone", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "bone": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "type": "number"
              }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "bone"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "bone": {
                "type": "string",
                "minLength": 1
              },
              "paperdoll": {
                "type": "string",
                "minLength": 1
              },
              "blend": {
                "enum": ["normal", "additive"]
              },
              "attachment": {
                "type": ["string", "null"]
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        "skins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "attachments"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["type", "path", "x", "y", "width", "height"],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "region"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "rotation": {
                            "type": "number"
                          },
                          "scaleX": {
                            "type": "number"
                          },
                          "scaleY": {
                            "type": "number"
                          },
                          "width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "height": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["type", "path", "width", "height", "uvs", "vertices", "triangles"],
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "const": "mesh"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "height": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "uvs": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "vertices": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "triangles": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "weights": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
