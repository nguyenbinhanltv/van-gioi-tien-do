{
  "name": "@vgtd/rig",
  "version": "0.1.0",
  "description": "AI animation authoring toolkit: format-neutral rig schema, animation DSL, DragonBones exporter, automated QA (D35/D36).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "artifacts": "vitest run test/artifacts.test.ts",
    "export:kiemtu": "vitest run test/kiemtu-data.test.ts",
    "gen:parts-spec": "vitest run test/classes.test.ts -t \"writes docs/art/parts-spec.md\"",
    "export:character": "vitest run test/kiemtu-data.test.ts",
    "rig:measure": "node scripts/run-ts.mjs scripts/measure.ts"
  },
  "dependencies": {
    "@vgtd/character": "*",
    "@vgtd/shared": "*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
