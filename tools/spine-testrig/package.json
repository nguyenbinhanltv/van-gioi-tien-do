{
  "name": "@vgtd/spine-testrig",
  "version": "0.1.0",
  "description": "Generates a minimal Spine 4.2 JSON test rig (placeholder parts, 13 animations, per-direction skeletons + atlases) for the Cocos animation viewer.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vgtd/character": "*",
    "@vgtd/shared": "*"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
