{
  "name": "@vgtd/procgen",
  "version": "1.0.0",
  "description": "Sinh asset Tu Tiên 2D Isometric 100% bằng code: tilemap, phi kiếm, icon, shader + pipeline đóng gói",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen:tilemap": "node src/tilemap/generate_tilemap.js --out out/tilemap",
    "gen:items": "node src/items/generate_items.js --out out/items",
    "gen:kiemtu": "vite-node --script scripts/kiem_tu_rig.mjs",
    "gen": "npm run gen:tilemap && npm run gen:items",
    "render": "node pipeline/render_layers.js out",
    "validate": "node pipeline/validate_assets.js --stage raw --root out --report out/reports/qa_raw.json --allow-warnings",
    "pack": "node scripts/pack_all.js out build/atlas",
    "compress": "node pipeline/compress_textures.js pc build/atlas build/dist/pc",
    "smoke": "node scripts/smoke.js",
    "preview": "node tools/build_preview.js",
    "build": "node scripts/check_syntax.js",
    "typecheck": "node scripts/check_syntax.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@vgtd/shared": "*",
    "@vgtd/character": "*"
  },
  "devDependencies": {
    "vite-node": "2.1.9"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
