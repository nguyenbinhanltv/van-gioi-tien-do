* text=auto eol=lf

# --- Git LFS: binary assets (see CONTRIBUTING.md) ---
# Images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
# GPU textures
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.astc filter=lfs diff=lfs merge=lfs -text
*.basis filter=lfs diff=lfs merge=lfs -text
# Spine / skeletal animation (binary only; .atlas and .json stay text)
*.spine filter=lfs diff=lfs merge=lfs -text
*.skel filter=lfs diff=lfs merge=lfs -text
# Audio
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
# 3D / source / archives
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# --- Exceptions (MUST stay after the LFS rules; later lines win) ---
# Existing committed doc diagrams stay plain git blobs (no history rewrite).
docs/** !filter !diff !merge binary
# Test fixtures are read via fs in tests: keep them as real files, not LFS pointers.
**/fixtures/** !filter !diff !merge binary
**/__fixtures__/** !filter !diff !merge binary
**/testdata/** !filter !diff !merge binary
