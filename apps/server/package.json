{
  "name": "@vgtd/server",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway + World Node skeleton (auth, 20 Hz authoritative simulation, AOI, snapshots) and bot load-test tool",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "backup": "node scripts/ops.mjs backup",
    "restore": "node scripts/ops.mjs restore",
    "verify": "node scripts/ops.mjs verify",
    "backups": "node scripts/ops.mjs list",
    "p2exit": "node scripts/p2-exit.mjs",
    "bench:tick": "node scripts/bench-tick.mjs"
  },
  "dependencies": {
    "@vgtd/protocol": "*",
    "@vgtd/shared": "*",
    "@vgtd/sim": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "esbuild": "^0.21.5",
    "@vgtd/client-combat": "*",
    "@vgtd/client-core": "*"
  }
}
