{
  /* Base configuration. Do not edit this field. */
  "extends": "./temp/tsconfig.cocos.json",

  /* Add your custom configuration here. */
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["assets/scripts/**/*.ts", "assets/scripts/vendor/*.d.mts", "temp/declarations/*.d.ts"],
  "exclude": ["library", "temp/programming", "build", "node_modules"]
}
